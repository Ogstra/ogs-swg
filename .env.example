# OGS-SWG Docker Configuration

# Application Settings
# Host port exposed by Docker (HOST:8080)
OGS_PORT=8111

# Optional admin bootstrap (needed on first run if DB has no admin user yet)
# OGS_ADMIN_USER=admin
# OGS_ADMIN_PASSWORD=change-me

# Database and Logs (Optional - defaults to data/stats.db and data/access.log)
# OGS_DB_PATH=/app/data/stats.db
# OGS_ACCESS_LOG_PATH=/app/data/access.log

# External profile dynamic IP files
# Host directory mounted read-only at /app/external-profile-ip in Docker.
# Set this to the host directory that contains dynamic IP files.
# Then use /app/external-profile-ip/<filename> in the External Profile IPv6 File Path field.
# OGS_EXTERNAL_PROFILE_IP_HOST_DIR=./homelab/ip

# API Authentication (Optional - if not set, uses JWT auth only)
# OGS_API_KEY=your-api-key-here

# SSH Remote Management (Optional)
# Uncomment and configure if managing a remote server
# OGS_SSH_HOST=192.168.1.50
# OGS_SSH_PORT=22
# OGS_SSH_USER=ogs_agent
# OGS_SSH_KEY_PATH=/data/ssh_key
# OGS_SSH_KEY_PASS=your_passphrase
# OGS_SSH_KNOWN_HOSTS=/data/known_hosts
# OGS_USE_STATS_SAMPLER=true
